{
  "permissions": {
    "allow": [
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(node knowledge/validate.mjs:*)",
      "Bash(node tools/status.mjs:*)",
      "Bash(node tools/contrast.mjs:*)",
      "Bash(node tools/cdp.mjs:*)",
      "Bash(node .claude/scripts/verify-gates.mjs:*)",
      "Bash(node .claude/scripts/session-stats.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-kb.mjs\"", "timeout": 60 }]
      }
    ]
  }
}
